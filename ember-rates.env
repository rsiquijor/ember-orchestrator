# Muse Ember (muse-ember-1.0) list prices, USD per 1K tokens.
# Source: https://dev.meta.ai/docs/pricing-rate-limits (fetched 2026-11-26)
# Per 1M tokens, requests up to 200K input tokens: input $0.10, output $0.50
# (cached input $0.004/1M — not modelled; the meter uses the uncached rate).
# Requests over 200K input tokens bill at $0.30 / $1.50 per 1M; the
# orchestrator never sends those (payloads are trimmed Cube-side).
EMBER_RATE_INPUT_PER_1K=0.0001
EMBER_RATE_OUTPUT_PER_1K=0.0005
